{
  "name": "@tim/keep-it-moving",
  "version": "0.1.0",
  "description": "Agent-driven interviews on a Cloudflare Worker: a browser questionnaire beside a living plan, diagrams, and mockups.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "interviewer": "dist/cli.js",
    "kim": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:web": "vite build",
    "build": "npm run build:cli && npm run build:web && npm run pack:cli",
    "pack:cli": "node scripts/pack-cli.mjs",
    "deploy": "npm run build && wrangler deploy",
    "desktop:dev": "tauri dev --config desktop/src-tauri/tauri.conf.json",
    "desktop:build": "tauri build --config desktop/src-tauri/tauri.conf.json",
    "typecheck": "tsc -p tsconfig.cli.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts vite.config.ts vitest.config.ts eslint.config.js",
    "format:check": "prettier --check .",
    "link:dev": "npm run build:cli && npm link",
    "unlink:dev": "npm unlink -g @tim/keep-it-moving @tim/interviewer || true",
    "link:skill": "node scripts/link-skill.mjs",
    "unlink:skill": "node scripts/link-skill.mjs --unlink",
    "setup:agents": "npm run link:skill && node scripts/add-global-context.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.1",
    "env-paths": "^3.0.0",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261002.1",
    "@eslint/js": "^9.39.5",
    "@hono/node-server": "^2.1.3",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0",
    "ws": "^8.21.3"
  }
}
