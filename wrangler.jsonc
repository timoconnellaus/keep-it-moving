{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interviewer",
  "account_id": "374784ce2915a597adcecf9bcb2c5ee6",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    { "pattern": "keep-it-moving.zerobsai.com", "custom_domain": true },
    // The old name, until everything has moved over.
    { "pattern": "interviewer.zerobsai.com", "custom_domain": true },
  ],
  "assets": {
    "directory": "./web-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "InterviewHub" },
      { "name": "SCREENSHOT_BUDGET", "class_name": "ScreenshotBudget" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["InterviewHub"] },
    { "tag": "v2", "new_sqlite_classes": ["ScreenshotBudget"] },
  ],
  // `kim inbox screenshot` renders in Cloudflare's browsers (Browser Run)
  // and keeps each PNG in R2. The bucket's lifecycle rule deletes them a
  // week after they're made:
  //   wrangler r2 bucket lifecycle add kim-screenshots expire-screenshots screenshots/ --expire-days 7
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [
    { "binding": "SCREENSHOTS", "bucket_name": "kim-screenshots" },
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "362d9bb9c4cb4509a8d8d3a540dad73c" },
  ],
  // AUTH_LIMITER: client registration, the token swap and Google sign-in
  // per client IP, and KV writes (assigning, making keys) per user.
  // API_LIMITER: everything a signed-in user does, per user, well above what
  // a few tabs and agents need. Any number unique in the account works as
  // the namespace id; nothing to set up in the dashboard. Limits are
  // approximate and counted per Cloudflare location.
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "API_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 1200, "period": 60 },
    },
  ],
  "vars": {
    "PUBLIC_URL": "https://keep-it-moving.zerobsai.com",
    // OWNER_EMAIL, GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are secrets
    // (`wrangler secret put`), so a fork doesn't deploy with ours. The Google
    // client's redirect URI is PUBLIC_URL + /auth/google/callback.
    "VAPID_PUBLIC_KEY": "BFBJwVqp8ONGf6it588x_gLRsw5dkqlyXVc9T3PlX0_QMrNLfc7aEqXPotuFR-g2CP_KGjxZTDyasvmg2eBNPjM",
  },
  "observability": { "enabled": true },
}
